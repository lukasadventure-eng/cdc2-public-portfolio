# Voice Gateway - Configuração de exemplo
# Copie para .env e ajuste conforme necessário

# Token de acesso (gerado automaticamente na primeira execução)
# VOICE_GATEWAY_TOKEN=

# Modo de STT (browser ou local)
VOICE_GATEWAY_STT_PROVEDOR=browser

# Modo de TTS (browser ou local)
VOICE_GATEWAY_TTS_PROVEDOR=browser

# Porta do servidor
VOICE_GATEWAY_PORT=8765